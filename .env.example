# ─────────────────────────────────────────────────────────────
# FutureShield AI — SafeHer Guardian  ·  Environment Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Agent Identity ────────────────────────────────────────────
# A stable seed phrase gives the agent a deterministic address.
# Generate a secure random phrase: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_SEED=replace_with_your_secure_random_seed_phrase_here

# Agent HTTP port (local transport layer)
AGENT_PORT=8000

# Public Endpoint URL (Optional: only needed if using Path A with ngrok / Cloudflare tunnel)
# Example: https://a1b2-c3d4.ngrok-free.app/submit
AGENT_ENDPOINT=

# ── Agentverse / Fetch.ai ────────────────────────────────────
# Obtain from: https://agentverse.ai → Profile → API Keys
# Required to use the Agentverse Mailbox (external-agent onboarding)
AGENTVERSE_API_KEY=av_replace_with_your_agentverse_api_key

# ── ASI:One LLM ──────────────────────────────────────────────
# Obtain from: https://asi1.ai → API Keys
# Used for natural-language interpretation and explanations.
ASI1_API_KEY=replace_with_your_asi1_api_key
ASI1_BASE_URL=https://api.asi1.ai/v1
ASI1_MODEL=asi1-mini

# ── Privacy / Sharing ────────────────────────────────────────
# Default duration (seconds) for auto-expiring location shares
LOCATION_SHARE_TTL_SECONDS=3600

# ── Emergency Contact (Guardian Mode) ────────────────────────
# Trusted-contact addresses for simulated notification (comma-separated uAgent addresses)
# Example: agent1q...,agent1q...
TRUSTED_CONTACT_ADDRESSES=

# ── Notifications ────────────────────────────────────────────
# Optional: webhook URL for test notifications (leave blank to disable)
NOTIFICATION_WEBHOOK_URL=

# ── Route / Map Provider ─────────────────────────────────────
# Optional: key for a real routing API (ORS, HERE, etc.)
# Leave blank to use clearly-labelled fixture data only.
ROUTING_API_KEY=
ROUTING_PROVIDER=fixture   # values: fixture | ors | here

# ── Safe-Haven / POI Provider ────────────────────────────────
# Optional: Google Places, Overpass, or similar
POI_API_KEY=
POI_PROVIDER=fixture       # values: fixture | overpass | google

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_FILE=logs/audit.jsonl
