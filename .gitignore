# ─────────────────────────────────────────────────────────────
# .gitignore — FutureShield AI SafeHer Guardian
# ─────────────────────────────────────────────────────────────

# Secret environment file (NEVER commit)
.env

# Python byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Audit and runtime logs (may contain PII)
logs/
*.jsonl
*.log

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
